class Stems < Formula
  desc "Local environment management toolkit for multi-process systems"
  homepage "https://github.com/acme/stems"
  version "0.1.0-rc.1"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/acme/stems/releases/download/v0.1.0-rc.1/stems-cli-aarch64-apple-darwin.tar.xz"
      sha256 "602526fe5d0720f8fb8f60272c924a754eb90c461381908e5d8a5f04f6e504c0"
    end
    on_intel do
      url "https://github.com/acme/stems/releases/download/v0.1.0-rc.1/stems-cli-x86_64-apple-darwin.tar.xz"
      sha256 "838636fb51c7c295f53ac0becfa66f4e7726c388af3fc9397e57c97f5f97c840"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/acme/stems/releases/download/v0.1.0-rc.1/stems-cli-aarch64-unknown-linux-gnu.tar.xz"
      sha256 "86bf552cb29f61118330fb817bc3819ddbade898c26ec8c0a3c825f4bc5e2e27"
    end
    on_intel do
      url "https://github.com/acme/stems/releases/download/v0.1.0-rc.1/stems-cli-x86_64-unknown-linux-gnu.tar.xz"
      sha256 "1bb87e07be9e52fc0dca53a1c0718fac23e8b4202b9c346e12f075762507a544"
    end
  end

  def install
    # The daemon is the same binary (`stems daemon`): one artifact.
    bin.install "stems"
    bash_completion.install "completions/stems.bash" => "stems"
    zsh_completion.install "completions/_stems"
    fish_completion.install "completions/stems.fish"
    man1.install Dir["man/*.1"]
  end

  def caveats
    <<~EOS
      After `brew upgrade stems`, restart running workspace daemons
      (`stems daemon stop`; the next command starts the new one).
    EOS
  end

  test do
    assert_match "stems #{version}", shell_output("#{bin}/stems --version")
    (testpath/"stems.yaml").write <<~YAML
      schema_version: 1
      name: brew-test
      stems:
        hello:
          type: process
          command: sleep 30
    YAML
    ENV["STEMS_HOME"] = (testpath/"home").to_s
    system bin/"stems", "validate", "--skip-requires", "--workspace", testpath
  end
end
