# Written by stems for `inject_env: true` and `build.secrets` (passed as a second `-f`); do not edit.
services:
  "api":
    env_file:
      - "/e/api.env"
    environment:
      PORT: "8080"
    build:
      secrets:
        - "adc"
        - "tok"
  "migrate":
    build:
      secrets:
        - "adc"
        - "tok"
secrets:
  "adc":
    file: "/home/me/.config/gcloud/adc.json"
  "tok":
    environment: "NPM_TOKEN"
